      "id": "293552cf-7502-4018-9957-02a4c3192732",
      "name": "Search Companies (Google Places)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -656,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "// Google Places results -> flat lead objects\nconst config = $('Config').first().json;\nconst results = $input.first().json.results || [];\n\nconst leads = results.map(r => ({\n  place_id: r.place_id,\n  name: r.name,\n  address: r.formatted_address || '',\n  lat: r.geometry?.location?.lat || null,\n  lng: r.geometry?.location?.lng || null,\n  website: null, // filled in later via Place Details if you extend this\n  googleSheetId: config.googleSheetId,\n  ollamaUrl: config.ollamaUrl,\n  ollamaModel: config.ollamaModel,\n  scoreThreshold: config.scoreThreshold,\n  batchTarget: config.batchTarget,\n  senderName: config.senderName,\n  senderCompany: config.senderCompany\n}));\n\nreturn leads.map(l => ({ json: l }));"
      },
      "id": "95a8a7b0-65f6-423d-b18b-b454f69de761",
      "name": "Parse Search Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        224
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "={{ $('Config').first().json.googleSheetId }}",
