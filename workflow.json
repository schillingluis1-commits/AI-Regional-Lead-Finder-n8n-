      "id": "b734cf76-d543-4539-b992-0087ea7b8be2",
      "name": "Scrape Website",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        224
      ],
      "retryOnFail": true,
      "onError": "continueRegularOutput"
