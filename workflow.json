    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.data || $input.first().json.body || '';\n   const text = String(raw)\n     .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n     .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n     .replace(/<[^>]+>/g, ' ')\n     .replace(/\\s+/g, ' ')\n     .trim()\n     .slice(0, 3000);\n\n   const lead = $('Loop Companies').item.json;\n   return [{ json: { ...lead, siteText: text } }];"
      },
      "id": "40f84087-8bda-4964-ab43-8a69d4e68cfc",
      "name": "Extract Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        224
      ]
