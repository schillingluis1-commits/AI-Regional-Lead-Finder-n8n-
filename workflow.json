      "id": "aa6edd5a-427f-4bb6-be95-ad346701ecbd",
      "name": "Get Existing List",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -448,
        448
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Cross-reference new leads against everything already logged (evaluated OR messaged)\nconst allLeads = $('Parse Search Results').all().map(i => i.json);\nconst existingRows = $input.all().map(i => i.json);\nconst existingIds = new Set(existingRows.map(r => r.place_id));\n\nconst fresh = allLeads.filter(l => !existingIds.has(l.place_id));\nconst target = fresh.slice(0, allLeads[0]?.batchTarget || 30);\n\nreturn target.map(l => ({ json: l }));"
      },
