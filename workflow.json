    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.ollamaUrl }}/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $('Config').first().json.ollamaModel,\n  prompt: `You are scoring whether a small/medium business is a good fit for AI-powered workflow automation and process consulting services (n8n automations, private DSGVO-compliant AI assistants).\\n\\nCompany: ${$json.name}\\nAddress: ${$json.address}\\nWebsite excerpt:\\n${$json.siteText}\\n\\nScore from 0-100 how likely this company would benefit from AND could afford automation/AI consulting. Consider: signs of manual/paper-based processes, outdated web presence, company size signals, industry (trades, logistics, local services score well; already-tech-native companies score lower).\\n\\nRespond ONLY with valid JSON: {\"score\": <number>, \"reasoning\": \"<one sentence>\"}`,\n  format: 'json',\n  stream: false\n}) }}",
        "options": {}
      },
      "id": "9cf04bbb-c3cb-4577-a1db-05bfe1c9a671",
      "name": "Score Lead (Ollama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1104,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Extract Text').first().json;\nlet parsed = { score: 0, reasoning: 'parse_failed' };\ntry {\n  const responseText = $input.first().json.response;\n  parsed = JSON.parse(responseText);\n} catch (e) {\n  // leave default on parse failure, gets logged with score 0 so it's visible in the sheet\n}\n\nreturn [{ json: { ...lead, score: Number(parsed.score) || 0, reasoning: parsed.reasoning || '' } }];"
      },
